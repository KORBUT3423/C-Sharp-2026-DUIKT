        static void Main(string[] args)
        {
            Random random =  new Random();
            int group = random.Next(3, 6);
            int[][] arr4 = new int[group][];
            
            for (int b = 0; b < arr4.Length; b++)
            {
                int students = random.Next(10, 31);
                arr4[b] = new int[students];
            }

            for (int i = 0; i < arr4.Length; i++)
            {
                for (int j = 0; j < arr4[i].Length; j++)
                {
                    arr4[i][j] = random.Next(1, 13);
                }
            }
            
            for (int i = 0; i < arr4.Length; i++)
            {
                Console.Write($"Група {i + 1}: ");

                for (int j = 0; j < arr4[i].Length; j++)
                {
                    Console.Write($"Student-{j} mark:{arr4[i][j] + " "}");
                }

                Console.WriteLine();
            }
            
            for (int i = 0; i < arr4.Length; i++)
            {
                int sum = 0;
                int min = arr4[i][0];
                int max = arr4[i][0];

                for (int j = 0; j < arr4[i].Length; j++)
                {
                    sum += arr4[i][j];

                    if (arr4[i][j] < min)
                    {
                        min = arr4[i][j];
                    }

                    if (arr4[i][j] > max)
                    {
                        max = arr4[i][j];
                    }
                }

                double average = (double)sum / arr4[i].Length;

                Console.WriteLine($"Group {i + 1}:");
                Console.WriteLine($"Average mark: {average:F2}");
                Console.WriteLine($"Min mark: {min}");
                Console.WriteLine($"Max mark: {max}");
            }
            
            int totalSum = 0;
            int totalStudents = 0;
            int totalMin = arr4[0][0];
            int totalMax = arr4[0][0];

            for (int i = 0; i < arr4.Length; i++)
            {
                int sum = 0;
                int min = arr4[i][0];
                int max = arr4[i][0];

                for (int j = 0; j < arr4[i].Length; j++)
                {
                    int mark = arr4[i][j];

                    sum += mark;

                    if (mark < min)
                        min = mark;

                    if (mark > max)
                        max = mark;

                    // Для всього потоку
                    totalSum += mark;
                    totalStudents++;

                    if (mark < totalMin)
                        totalMin = mark;

                    if (mark > totalMax)
                        totalMax = mark;
                }

                double average = (double)sum / arr4[i].Length;

                Console.WriteLine($"Group {i + 1}:");
                Console.WriteLine($"Average mark: {average:F2}");
                Console.WriteLine($"Min mark: {min}");
                Console.WriteLine($"Max mark: {max}");
                Console.WriteLine();
            }

            double totalAverage = (double)totalSum / totalStudents;

            Console.WriteLine("===== Whole course =====");
            Console.WriteLine($"Average mark: {totalAverage:F2}");
            Console.WriteLine($"Min mark: {totalMin}");
            Console.WriteLine($"Max mark: {totalMax}");
            
